rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /foods/custom {
      allow read, write: if true;
    }

    match /macroLogs/{person}/days/{date} {
      allow read, write: if true;
    }
  }
}
